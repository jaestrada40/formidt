# ---- App ----
NODE_ENV=development
PORT=3000
# Public URL where this app is reachable (used in email links, CORS, cookies).
APP_URL=http://localhost:3000

# ---- Database (Postgres, e.g. the Postgres service Coolify manages) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/enrollment_portal?schema=public"

# ---- Auth (JWT) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="MY_JWT_ACCESS_SECRET"
JWT_REFRESH_SECRET="MY_JWT_REFRESH_SECRET"

# ---- Field-level encryption (SSNs at rest) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="MY_32_BYTE_BASE64_KEY"

# ---- Admin account (Lourdes) ----
# Used by `npm run seed:admin` to create/reset the admin login.
ADMIN_EMAIL="lourdes.paredes@idt.net"

# ---- Email notifications (SMTP) ----
# Where every new submission gets sent.
NOTIFY_EMAIL="lourdes.paredes@idt.net"
# Your IDT (or provider) SMTP credentials.
SMTP_HOST="smtp.idt.net"
SMTP_PORT="587"
SMTP_USER="MY_SMTP_USER"
SMTP_PASS="MY_SMTP_PASSWORD"
SMTP_FROM="Enrollment Portal <no-reply@idt.net>"

# ---- Anti-bot (Cloudflare Turnstile — free, https://dash.cloudflare.com/?to=/:account/turnstile) ----
TURNSTILE_SECRET_KEY="MY_TURNSTILE_SECRET_KEY"
# Also set as VITE_TURNSTILE_SITE_KEY so the frontend build can read it.
VITE_TURNSTILE_SITE_KEY="MY_TURNSTILE_SITE_KEY"
